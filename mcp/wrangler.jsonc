{
  "name": "usagi-lang",
  "main": "worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "GATEWAY", "class_name": "DiscordGateway" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiscordGateway"] }]
}
